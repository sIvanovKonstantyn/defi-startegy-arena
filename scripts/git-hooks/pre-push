#!/usr/bin/env bash
set -euo pipefail

# stdin lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref}" ]] && continue

  remote_branch="${remote_ref##*/}"
  if [[ "${remote_branch}" == "main" || "${remote_branch}" == "master" ]]; then
    # Allow the very first push of an empty→initial commit only when local history has exactly one commit
    # and remote has none (zero sha).
    zero="0000000000000000000000000000000000000000"
    local_count="$(git rev-list --count "${local_sha}" 2>/dev/null || echo 0)"

    if [[ "${remote_sha}" == "${zero}" && "${local_count}" -eq 1 ]]; then
      echo "[pre-push] Allowing initial push of first commit to ${remote_branch}."
      continue
    fi

    echo "[pre-push] Pushing to '${remote_branch}' is forbidden after the initial commit." >&2
    echo "[pre-push] Push a review/<feature> branch and open a PR instead." >&2
    blocked=1
  fi
done

if [[ "${blocked}" -ne 0 ]]; then
  exit 1
fi
