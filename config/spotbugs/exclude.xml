<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <Match>
        <Class name="com.defistrategyarena.shared.infra.http.jetty.JettyServerStopSupport$StopAttempt"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>
    <Match>
        <Class name="com.defistrategyarena.strategy.adapter.web.CreateStrategyHttpRequest"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.defistrategyarena.strategy.application.UpdateStrategyCommand"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.defistrategyarena.strategy.domain.Strategy$PublishNewVersionData"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Class name="com.defistrategyarena.bootstrap.ApplicationComposition"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="~.*\$\w+Deps"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
